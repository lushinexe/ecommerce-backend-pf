<h1>Carrito</h1>

{{#if cart.products.length}}
  <ul>
    {{#each cart.products}}
      <li>
        <h3>{{this.product.title}}</h3>
        <p>Precio: ${{this.product.price}}</p>
        <p>Cantidad: {{this.quantity}}</p>

        <!-- Botón para actualizar cantidad -->
        <form action="/carts/{{../cart._id}}/products/{{this.product._id}}" method="POST">
          <input type="number" name="quantity" value="{{this.quantity}}" min="1" />
          <button type="submit">Actualizar cantidad</button>
        </form>

        <!-- Botón para eliminar producto -->
        <form action="/carts/{{../cart._id}}/products/{{this.product._id}}" method="POST">
          <input type="hidden" name="_method" value="DELETE" />
          <button type="submit">Eliminar</button>
        </form>
      </li>
    {{/each}}
  </ul>

  <!-- Botón para vaciar carrito -->
  <form action="/carts/{{cart._id}}" method="POST">
    <input type="hidden" name="_method" value="DELETE" />
    <button type="submit">Vaciar carrito</button>
  </form>
{{else}}
  <p>El carrito está vacío.</p>
{{/if}}
